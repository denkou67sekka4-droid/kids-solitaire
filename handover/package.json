{
  "name": "handover-qr",
  "version": "1.0.0",
  "description": "荷物引渡し管理アプリ（QR発行 / スマホ読取 / 電子サイン）",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --no-warnings src/server.js",
    "dev": "node --no-warnings --watch src/server.js",
    "cert": "bash scripts/make-cert.sh",
    "adduser": "node --no-warnings scripts/adduser.mjs",
    "backup": "node --no-warnings scripts/backup.mjs",
    "test": "node --no-warnings --test \"test/*.test.js\"",
    "smoke": "node --no-warnings scripts/smoke.mjs"
  },
  "//": "実行に必要な依存はありません。QRの生成・読取ライブラリ(MIT)は同梱してあるので、npm install なしで起動できます。",
  "dependencies": {},
  "devDependencies": {
    "playwright": "^1.62.1"
  }
}
